Package: LEAP
Title: A novel phylogeny-based computational framework for inferring the transcriptional states of internal nodes.
Version: 0.0.0.9000
Authors@R: 
    c(
    person(given = "Shanjun",family = "Deng",email = "dengshj8@mail.sysu.edu.cn",role = c("cre","aut","fnd")),
    person(given = "Xionglei",family = "He",role = c("aut","fnd")),
