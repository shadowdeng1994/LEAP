tmp.subdata <- tmp.data %>% select(Gender="性别",Age="年龄组.岁.",Height="身高.厘米.",Weight="体重.千克.")
tmp.subdata
tmp.subdata %>% arrange(Height)
tmp.subdata %>% arrange(-Height)
tmp.subdata %>% arrange(-Height)
tmp.subdata %>% filter(min_rank()-Height)
tmp.subdata %>% filter(min_rank(-Height)==1)
tmp.subdata %>% filter(min_rank(-Height)==1)
tmp.subdata %>% filter(min_rank(-Height)==1)
tmp.subdata %>% filter(Height==max(Height))
tmp.subdata %>% filter(min_rank(-Height)==1)
tmp.subdata %>% filter(Gender=="女") %>% filter(min_rank(-Height)==1)
tmp.subdata %>% group_by()="女") %>% filter(min_rank(-Height)==1)
tmp.subdata %>% group_by(Gender) %>% filter(min_rank(-Height)==1)
tmp.subdata %>% filter(Gender=="男") %>% filter(min_rank(-Height)==1)
tmp.subdata %>% group_by(Gender) %>% summarise(Mean=mean(Height))
